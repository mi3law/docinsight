{
  "manifest_version": 3,
  "name": "DocInsight",
  "version": "0.1.0",
  "description": "See how a Google Doc was written: a timeline of its revision history, bulk insertions and writing-process indicators. Everything stays in your browser.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://docs.google.com/*"],
  "icons": { "16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/d/*", "https://docs.google.com/document/u/*/d/*"],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://docs.google.com/document/d/*", "https://docs.google.com/document/u/*/d/*"],
      "js": ["extension/main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extension/overlay.html", "extension/diagnostics.html"],
      "matches": ["https://docs.google.com/*"]
    }
  ]
}
